{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ECFD Dialogue Scenario Schema",
  "type": "object",
  "required": ["scenarioId", "attackType", "language", "speakers", "utterances"],
  "properties": {
    "scenarioId": { "type": "string" },
    "attackType": { "type": "string", "enum": ["BENIGN", "OTP_THEFT", "IMPERSONATION_CREDENTIAL", "REMOTE_TAKEOVER", "SYNTHETIC_VOICE"] },
    "language": { "type": "string", "enum": ["ar-EG", "ar-EG/en", "en"] },
    "speakers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "role": { "type": "string", "enum": ["EMPLOYEE", "CALLER"] }
        }
      }
    },
    "utterances": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["speakerId", "text", "startMs", "endMs", "tactics", "expectedStage"],
        "properties": {
          "speakerId": { "type": "string" },
          "text": { "type": "string" },
          "startMs": { "type": "integer" },
          "endMs": { "type": "integer" },
          "tactics": {
            "type": "array",
            "items": { "type": "string" }
          },
          "expectedStage": { "type": "string" }
        }
      }
    }
  }
}
