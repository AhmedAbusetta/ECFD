{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "backend/ECFD.Api/ECFD.Api.csproj",
        "--urls",
        "http://localhost:5000"
      ],
      "port": 5000
    },
    {
      "name": "backend-real-ml",
