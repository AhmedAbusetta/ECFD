# ==========================================
# ECFD Monorepo — Production .gitignore
# ==========================================

# --- Environment & Secrets ---
.env
.env.local
.env.*.local
*.pem
*.key
*.cert
*.pfx

# --- .NET & Visual Studio ---
bin/
obj/
*.user
*.suo
*.userosscache
*.sln.docstates
.vs/
.vscode/
TestResults/
*.resharper
*.dotCover

# --- Python & PyTorch ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- ML Weights & Large Checkpoints ---
# (Store model manifests in git, store binary checkpoints externally / S3 / HuggingFace)
*.pt
*.pth
*.bin
*.onnx
*.safetensors
*.engine
*.tflite
models/checkpoints/

# --- Node.js & React / Next.js ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.next/
out/
.pnpm-debug.log*

# --- Audio Files & Dataset Recordings ---
# (Small sample clips for unit tests are allowed in data/samples/, raw audio ignored)
*.wav
*.mp3
*.flac
*.ogg
*.raw
*.pcm
data/raw_recordings/
data/audio_dumps/

# --- Database & Persistence Dumps ---
*.sql.gz
*.dump
pgdata/
postgres_data/

# --- OS & IDE Specific ---
.DS_Store
Thumbs.db
ehthumbs.db
[Nn]otebooks/.ipynb_checkpoints

# --- Test recordings & transcripts (volunteers' voices; never commit) ---
ml/asr/test1/recordings/
ml/asr/test1/results/

# --- Simulated call logs (transcripts of volunteers; never commit) ---
ml/lab/calls/

# Machine-local backend config (private URLs such as the Modal ASR endpoint)
appsettings.Local.json

# Private business documents - kept local, not published (public repo)
docs/ECFD_Sponsorship_*
docs/ECFD_Simple_Proposal.*
docs/ECFD_Backend_TechStack_Research.docx
docs/reports/ECFD_Real_World_Feasibility.pdf
# Third-party papers: cite by link, don't republish
research/
# Build artifacts
frontend/tsconfig.tsbuildinfo

# Machine-specific Asterisk NAT address (written by telephony/asterisk/mac-setup.sh)
telephony/asterisk/pjsip_nat.conf

# Test 2: volunteers voices, names and transcripts (never commit)
ml/asr/test2/recordings/
ml/asr/test2/results/
ml/asr/test2/pack/
ml/asr/test2/team.json

# generated warning prompts (synthetic voice, no recordings of people) - played to the employee by Asterisk
!telephony/asterisk/sounds/*.wav
