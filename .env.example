# ==========================================
# ECFD Environment Configuration Template
# Copy this file to .env and fill in your values
# ==========================================

# --- PostgreSQL Database ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ecfd_db
POSTGRES_USER=ecfd_app_user
POSTGRES_PASSWORD=replace_with_secure_dev_password
DB_CONNECTION_STRING="Host=localhost;Port=5432;Database=ecfd_db;Username=ecfd_app_user;Password=replace_with_secure_dev_password;"

# --- ASP.NET Core Backend ---
ASPNETCORE_ENVIRONMENT=Development
BACKEND_PORT=5000
BACKEND_URL=http://localhost:5000

# --- Asterisk PBX & ARI ---
ASTERISK_HOST=asterisk
ASTERISK_ARI_URL=http://asterisk:8088/ari
ASTERISK_ARI_USER=ecfd_ari_admin
ASTERISK_ARI_PASSWORD=replace_with_secure_ari_password
ASTERISK_ARI_APP_NAME=ecfd-stasis

# --- Media Gateway (RTP Receiver) ---
MEDIA_GATEWAY_RTP_PORT=40000
MEDIA_AUDIO_SAMPLE_RATE=16000
MEDIA_AUDIO_WINDOW_MS=500

# --- Python ML Microservices ---
# Set to 'true' to use lightweight mock mode (0 GPU needed)
ML_USE_MOCK_MODE=true

ASR_SERVICE_URL=http://localhost:8001
ASR_MODEL_NAME=faster-whisper-medium
ASR_DEVICE=cpu

NLP_SERVICE_URL=http://localhost:8002
NLP_MODEL_NAME=UBC-NLP/MARBERT
NLP_DEVICE=cpu

ANTISPOOF_SERVICE_URL=http://localhost:8003
ANTISPOOF_MODEL_NAME=AASIST
ANTISPOOF_DEVICE=cpu

# --- Frontend ---
NEXT_PUBLIC_BACKEND_SIGNALR_URL=http://localhost:5000/hubs/dashboard
FRONTEND_PORT=3000

# --- Outside services (see docs/setup/01_Accounts_and_Keys.md) ---
# Real values go in .env only. Never commit, print, or paste them in chat.
# Brain (LLM) provider: groq (default, free) | gemini (free, 20 requests/day) | claude (later, paid)
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
SPEECHMATICS_API_KEY=
# URL printed by `modal deploy ml/asr/modal_app.py` (keep private: it spends your Modal credits)
COHERE_ASR_URL=
ELEVENLABS_API_KEY=
AZURE_VM_PUBLIC_IP=
